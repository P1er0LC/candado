<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Candado" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="@Panel" Foreground="@Texto"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    @@ESTILOS@@
  </Window.Resources>

  <Border x:Name="Raiz" Background="@Panel" Padding="26,22,26,20">
    <StackPanel>
      <DockPanel>
        <TextBlock x:Name="Icono" DockPanel.Dock="Left" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="@Acento" Margin="0,2,14,0" VerticalAlignment="Top"/>
        <StackPanel>
          <TextBlock x:Name="Titulo" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <TextBlock x:Name="Ruta" Style="{StaticResource Tenue}" FontSize="12" Margin="0,2,0,0"/>
        </StackPanel>
      </DockPanel>

      <StackPanel x:Name="PanelClave" Margin="0,8,0,0">
        <TextBlock Text="Contraseña" Style="{StaticResource Etiqueta}"/>
        <PasswordBox x:Name="Clave"/>
      </StackPanel>

      <StackPanel x:Name="PanelRecuperar" Margin="0,8,0,0" Visibility="Collapsed">
        <TextBlock Style="{StaticResource Tenue}" Margin="0,4,0,0" Text="Pega la clave de recuperación que te llegó por correo cuando la protegiste, y elige una contraseña nueva."/>
        <TextBlock Text="Clave de recuperación" Style="{StaticResource Etiqueta}"/>
        <TextBox x:Name="ClaveRecuperacion" FontFamily="Cascadia Mono, Consolas"/>
        <TextBlock Text="Contraseña nueva (al menos 8 caracteres)" Style="{StaticResource Etiqueta}"/>
        <PasswordBox x:Name="Nueva1"/>
        <TextBlock Text="Repítela" Style="{StaticResource Etiqueta}"/>
        <PasswordBox x:Name="Nueva2"/>
      </StackPanel>

      <StackPanel x:Name="PanelProgreso" Margin="0,18,0,0" Visibility="Collapsed">
        <ProgressBar x:Name="Barra" Height="6" Maximum="1000"/>
        <TextBlock x:Name="Detalle" Foreground="@Tenue" FontSize="12" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
      </StackPanel>

      <TextBlock x:Name="Mensaje" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed"/>

      <DockPanel Margin="0,20,0,0" LastChildFill="False">
        <Button x:Name="Enlace" DockPanel.Dock="Left" Style="{StaticResource BotonEnlace}" Content="Olvidé mi contraseña"/>
        <Button x:Name="Principal" DockPanel.Dock="Right" Style="{StaticResource Boton}" IsDefault="True"/>
        <Button x:Name="Secundario" DockPanel.Dock="Right" Style="{StaticResource BotonSecundario}" Content="Cancelar" Margin="0,0,8,0" IsCancel="True"/>
      </DockPanel>
    </StackPanel>
  </Border>
</Window>
